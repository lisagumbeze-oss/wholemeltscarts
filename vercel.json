{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin(.*)", "destination": "/index.html" },
    { "source": "/((?!sitemap\\.xml|robots\\.txt|favicon\\.ico|favicon\\.svg|assets/|images/|video/).*)", "destination": "/index.html" }
  ]
}
